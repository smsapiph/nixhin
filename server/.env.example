# Copy to .env and adjust. Every value is optional; the defaults suit local development.

# development | production | test
NODE_ENV=development

# Bind to loopback by default. Use 0.0.0.0 only behind a reverse proxy / in a container.
HOST=127.0.0.1
PORT=8787

# Comma-separated list of browser origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:5173

# Set to true ONLY when running behind exactly one trusted reverse proxy that sets X-Forwarded-For.
# Otherwise clients could spoof their IP and dodge rate limiting.
TRUST_PROXY=false

# Requests per minute allowed per client IP.
RATE_LIMIT_PER_MINUTE=120

# Upstream AniList settings. AniList currently allows 30 requests/minute per IP.
ANILIST_URL=https://graphql.anilist.co
UPSTREAM_REQUESTS_PER_MINUTE=28
UPSTREAM_TIMEOUT_MS=8000

# Episode playback through a LICENSED provider's embed player (leave empty to show trailers only).
# Placeholders: {anilistId}, {malId}, {episode}, {language}. Must be https; the host is fixed here,
# so requests can only ever load this provider. Replace example.com with your provider's URL.
STREAM_EMBED_TEMPLATE=https://megaplay.buzz/stream/ani/{anilistId}/{episode}/{language}
# Variants the provider offers, comma-separated; the first is the default.
STREAM_LANGUAGES=sub,dub


# Movies & TV shows (optional). TMDB "API Read Access Token" from themoviedb.org → Settings → API.
# Leave empty to keep the site anime-only.
TMDB_READ_TOKEN=
# Movie / TV playback through a LICENSED provider (optional; empty = trailers only). https only.
# Movie placeholders: {tmdbId}, {imdbId}. TV adds {season} and {episode}.
STREAM_MOVIE_TEMPLATE=
STREAM_TV_TEMPLATE=
